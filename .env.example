# Connection string for your Postgres database. Used for BOTH local
# development and production -- there's no separate local database.
#
# Get a free one at https://neon.tech:
#   1. Sign up (no credit card needed) and create a project.
#   2. On the project dashboard, copy the "Connection string" (use the
#      pooled connection, usually labeled with "-pooler" in the hostname --
#      this matters once deployed, since serverless functions open many
#      short-lived connections).
#   3. Paste it below.
DATABASE_URL=

# Used to sign login session tokens. Set this to a long random string
# before deploying anywhere other than your own machine -- a development
# default is used if left blank, which is fine for local use only.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the Express API server listens on when run locally (default: 3001).
PORT=3001
