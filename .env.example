# Both of these are optional for local use -- sensible defaults are built in.
# Copy this file to .env only if you want to override them.

# Port the Express API server listens on (default: 3001)
PORT=3001

# Used to sign session cookies. A development default is used if unset.
# If you ever run this somewhere other than your own machine, set a long
# random value here instead of relying on the default.
SESSION_SECRET=
